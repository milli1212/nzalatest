# ==============================================================================
# NzalaFamilly - Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual secrets or production keys to source control.
# Copy this file to .env and provide real credentials in production.

# --- 1. SERVER & APPLICATION RUNTIME ---
PORT=3000
NODE_ENV=production
APP_URL=https://nzala.family
API_BASE_URL=https://api.nzala.family/v1
CORS_ALLOWED_ORIGINS=https://nzala.family,https://app.nzala.family

# --- 2. DATABASE CONFIGURATION (PostgreSQL / Cloud SQL / Firebase) ---
# Primary Relational Engine: PostgreSQL 15+ / Google Cloud SQL
DATABASE_URL=postgresql://user:password@localhost:5432/nzalafamilly?schema=public&sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000

# (Alternative) Firebase / Firestore Configuration (if hybrid or mobile SDK used)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIRESTORE_DATABASE_ID=(default)

# --- 3. AUTHENTICATION & SECURITY (JWT & Argon2) ---
AUTH_JWT_SECRET=your-256-bit-secret-must-be-at-least-32-chars-long
AUTH_JWT_EXPIRES_IN=1h
AUTH_REFRESH_SECRET=your-long-refresh-token-secret-key-goes-here
AUTH_REFRESH_EXPIRES_IN=30d
AUTH_ARGON2_MEMORY_COST=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=4
SESSION_COOKIE_SECRET=your-secure-session-cookie-signing-secret

# --- 4. SECURE CLOUD STORAGE (Photos, Videos, Audio, Documents) ---
# S3-compatible or Google Cloud Storage Bucket
STORAGE_PROVIDER=gcs # Options: gcs, s3, local
STORAGE_BUCKET_NAME=nzalafamilly-production-media
STORAGE_REGION=europe-west1
STORAGE_PUBLIC_BASE_URL=https://storage.googleapis.com/nzalafamilly-production-media
STORAGE_SIGNING_PRIVATE_KEY=
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600
STORAGE_VIEW_ONCE_EXPIRY_SECONDS=120

# --- 5. REAL-TIME & WEBSOCKET ENGINE ---
WS_PORT=3001
WS_HEARTBEAT_INTERVAL_MS=25000
WS_CONNECTION_TIMEOUT_MS=60000
REDIS_URL=redis://localhost:6379/0

# --- 6. WEBRTC & NZALA CALLS (STUN / TURN) ---
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=turn:turn.nzala.family:3478
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_SIGNALING_SECRET=

# --- 7. NZALA LIVE (STREAMING & BROADCAST) ---
LIVE_STREAM_RTMP_INGEST_URL=rtmps://live.nzala.family/live
LIVE_STREAM_HLS_PLAYBACK_URL=https://live-cdn.nzala.family/hls
LIVE_MAX_CONCURRENT_VIEWERS=1000
LIVE_RECORDING_ENABLED=true

# --- 8. PUSH NOTIFICATIONS (Web Push / FCM) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nzala.family
FCM_SERVER_KEY=

# --- 9. RATE LIMITING & ABUSE MITIGATION ---
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_REQUESTS_PER_MINUTE=120
RATE_LIMIT_UPLOADS_PER_HOUR=30

# --- 10. ENCRYPTION & DATA PRIVACY ---
FIELD_ENCRYPTION_KEY=32-character-random-key-for-sensitive-fields-aes256
VIEW_ONCE_SALT=random-salt-for-ephemeral-media-tokens

